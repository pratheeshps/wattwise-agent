{
  "name": "wattwise-agent",
  "version": "2.0.0",
  "private": true,
  "description": "Wattwise — local-first electricity and solar bill analytics",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test",
    "test:smoke": "node scripts/production-smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test:integration": "npm run db:generate && node scripts/authenticated-api-integration.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "dotenv": "^18.0.9",
    "next": "16.4.5",
    "pdf-parse": "1.1.1",
    "primeicons": "^7.0.0",
    "primereact": "9.6.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "@aws-sdk/client-s3": "^3.850.0",
    "@aws-sdk/s3-request-presigner": "^3.850.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "better-auth": "^1.4.0",
    "pg": "^8.16.3",
    "nodemailer": "^7.0.5"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "prisma": "^7.0.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
