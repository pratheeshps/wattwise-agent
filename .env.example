PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/wattwise
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
SMTP_URL=smtps://USERNAME:PASSWORD@SMTP_HOST:465
SMTP_FROM="Wattwise <no-reply@example.com>"

# Local filesystem is the default and is recommended for local development.
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./storage/bills

# Required to authorize scheduled retries of failed object-storage cleanup.
STORAGE_CLEANUP_SECRET=

# Required only when STORAGE_PROVIDER=s3 (AWS S3, Cloudflare R2, MinIO, etc.).
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=
